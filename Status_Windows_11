# Carrega as bibliotecas visuais nativas do Windows de forma explícita
Add-Type -AssemblyName System.Windows.Forms, System.Drawing

# === 1. COLETA E PROCESSAMENTO DE DADOS ===

# Uptime
$LastBoot = (Get-CimInstance -ClassName Win32_OperatingSystem).LastBootUpTime
$Uptime = (Get-Date) - $LastBoot
$UptimeStr = "{0} dias, {1} horas e {2} minutos" -f $Uptime.Days, $Uptime.Hours, $Uptime.Minutes

# CPU
$CpuObj = Get-CimInstance -ClassName Win32_Processor
$CpuModel = $CpuObj.Name.Trim()
$CpuCores = "$($CpuObj.NumberOfCores) Físicos / $($CpuObj.NumberOfLogicalProcessors) Lógicos"

# RAM
$RamOS = Get-CimInstance -ClassName Win32_OperatingSystem
$TotalRam = [Math]::Round($RamOS.TotalVisibleMemorySize / 1MB, 1)
$FreeRam = [Math]::Round($RamOS.FreePhysicalMemory / 1MB, 1)
$UsedRam = [Math]::Round($TotalRam - $FreeRam, 1)
$RamPct = [Math]::Round(($UsedRam / $TotalRam) * 100, 1)

# Disco C:
$DiskC = Get-CimInstance -ClassName Win32_LogicalDisk -Filter "DeviceID='C:'"
$TotalDisk = [Math]::Round($DiskC.Size / 1GB, 1)
$FreeDisk = [Math]::Round($DiskC.FreeSpace / 1GB, 1)
$UsedDisk = [Math]::Round($TotalDisk - $FreeDisk, 1)
$DiskPct = [Math]::Round(($UsedDisk / $TotalDisk) * 100, 1)

# Tabelas Técnicas Avançadas
$RamDetailsText = Get-CimInstance -ClassName Win32_OperatingSystem | Format-List *Memory* | Out-String
$DiskPartitionsText = Get-CimInstance -ClassName Win32_LogicalDisk -Filter "DriveType=3" | Select-Object DeviceID, VolumeName, @{N="Size(GB)";E={[Math]::Round($_.Size/1GB,1)}}, @{N="Free(GB)";E={[Math]::Round($_.FreeSpace/1GB,1)}} | Format-Table | Out-String

# === 2. CONSTRUÇÃO DA INTERFACE VISUAL (WINDOWS FORMS) ===

# Criação da Janela Principal
$Form = New-Object System.Windows.Forms.Form
$Form.Text = "Painel de Controle - Monitoramento do Sistema"
$Form.Size = New-Object System.Drawing.Size(650, 520)
$Form.StartPosition = "CenterScreen"
$Form.BackColor = [System.Drawing.Color]::FromArgb(245, 246, 250)
$Form.Font = New-Object System.Drawing.Font("Segoe UI", 9)

# Criação das Abas (TabControl)
$TabControl = New-Object System.Windows.Forms.TabControl
$TabControl.Size = New-Object System.Drawing.Size(610, 440)
$TabControl.Location = New-Object System.Drawing.Point(12, 12)

# ---- ABA 1: RESUMO GERAL ----
$Tab1 = New-Object System.Windows.Forms.TabPage
$Tab1.Text = "Resumo Geral"
$Tab1.BackColor = [System.Drawing.Color]::White

# Título Principal
$LblTitle = New-Object System.Windows.Forms.Label
$LblTitle.Text = "Métricas em Tempo Real"
$LblTitle.Font = New-Object System.Drawing.Font("Segoe UI", 16, [System.Drawing.FontStyle]::Bold)
$LblTitle.ForeColor = [System.Drawing.Color]::FromArgb(44, 62, 80)
$LblTitle.Location = New-Object System.Drawing.Point(20, 15)
$LblTitle.Size = New-Object System.Drawing.Size(300, 30)
$Tab1.Controls.Add($LblTitle)

# Informação de Uptime
$LblUptime = New-Object System.Windows.Forms.Label
$LblUptime.Text = "🕒 Uptime: $UptimeStr"
$LblUptime.Font = New-Object System.Drawing.Font("Segoe UI", 11, [System.Drawing.FontStyle]::Regular)
$LblUptime.Location = New-Object System.Drawing.Point(20, 60)
$LblUptime.Size = New-Object System.Drawing.Size(550, 25)
$Tab1.Controls.Add($LblUptime)

# Informação de CPU
$LblCpu = New-Object System.Windows.Forms.Label
$LblCpu.Text = "⚙️ Processador: $CpuCores"
$LblCpu.Font = New-Object System.Drawing.Font("Segoe UI", 11, [System.Drawing.FontStyle]::Regular)
$LblCpu.Location = New-Object System.Drawing.Point(20, 95)
$LblCpu.Size = New-Object System.Drawing.Size(550, 25)
$Tab1.Controls.Add($LblCpu)

# Barra de Progresso RAM
$LblRamTitle = New-Object System.Windows.Forms.Label
$LblRamTitle.Text = "🧠 Uso de Memória RAM ($RamPct%)"
$LblRamTitle.Font = New-Object System.Drawing.Font("Segoe UI", 10, [System.Drawing.FontStyle]::Bold)
$LblRamTitle.Location = New-Object System.Drawing.Point(20, 140)
$LblRamTitle.Size = New-Object System.Drawing.Size(400, 20)
$Tab1.Controls.Add($LblRamTitle)

$PbRam = New-Object System.Windows.Forms.ProgressBar
$PbRam.Location = New-Object System.Drawing.Point(20, 165)
$PbRam.Size = New-Object System.Drawing.Size(550, 23)
