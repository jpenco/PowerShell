$Tab1.Controls.Add($PbRam)

$LblRamSub = New-Object System.Windows.Forms.Label
$LblRamSub.Text = "Usado: $UsedRam GB / Total: $TotalRam GB"
$LblRamSub.ForeColor = [System.Drawing.Color]::Gray
$LblRamSub.Location = New-Object System.Drawing.Point(20, 195)
$LblRamSub.Size = New-Object System.Drawing.Size(400, 20)
$Tab1.Controls.Add($LblRamSub)

# Barra de Progresso DISCO
$LblDiskTitle = New-Object System.Windows.Forms.Label
$LblDiskTitle.Text = "💾 Armazenamento - Unidade C: ($DiskPct%)"
$DiskStatusColor = [System.Drawing.Color]::FromArgb(52, 73, 94)
$LblDiskTitle.Font = New-Object System.Drawing.Font("Segoe UI", 10, [System.Drawing.FontStyle]::Bold)
$LblDiskTitle.Location = New-Object System.Drawing.Point(20, 235)
$LblDiskTitle.Size = New-Object System.Drawing.Size(400, 20)
$Tab1.Controls.Add($LblDiskTitle)

$PbDisk = New-Object System.Windows.Forms.ProgressBar
$PbDisk.Location = New-Object System.Drawing.Point(20, 260)
$PbDisk.Size = New-Object System.Drawing.Size(550, 23)
$PbDisk.Value = [int]$DiskPct
$Tab1.Controls.Add($PbDisk)

$LblDiskSub = New-Object System.Windows.Forms.Label
$LblDiskSub.Text = "Usado: $UsedDisk GB / Total: $TotalDisk GB"
$LblDiskSub.ForeColor = [System.Drawing.Color]::Gray
$LblDiskSub.Location = New-Object System.Drawing.Point(20, 290)
$LblDiskSub.Size = New-Object System.Drawing.Size(400, 20)
$Tab1.Controls.Add($LblDiskSub)

# ---- ABA 2: DETALHES DO PROCESSADOR ----
$Tab2 = New-Object System.Windows.Forms.TabPage
$Tab2.Text = "Processador"
$Tab2.BackColor = [System.Drawing.Color]::White

$TxtCpu = New-Object System.Windows.Forms.TextBox
$TxtCpu.Multiline = $true
$TxtCpu.ReadOnly = $true
$TxtCpu.Font = New-Object System.Drawing.Font("Consolas", 10)
$TxtCpu.Size = New-Object System.Drawing.Size(570, 380)
$TxtCpu.Location = New-Object System.Drawing.Point(15, 15)
$TxtCpu.Text = "Modelo da CPU: $CpuModel`r`n`r`nVelocidade Máxima: $($CpuObj.MaxClockSpeed) MHz`r`nVelocidade Atual: $($CpuObj.CurrentClockSpeed) MHz`r`nNúcleos Físicos: $($CpuObj.NumberOfCores)"
$Tab2.Controls.Add($TxtCpu)

# ---- ABA 3: DETALHES AVANÇADOS ----
$Tab3 = New-Object System.Windows.Forms.TabPage
$Tab3.Text = "Memória e Partições"
$Tab3.BackColor = [System.Drawing.Color]::White

$TxtAdvanced = New-Object System.Windows.Forms.TextBox
$TxtAdvanced.Multiline = $true
$TxtAdvanced.ReadOnly = $true
$TxtAdvanced.ScrollBars = "Vertical"
$TxtAdvanced.Font = New-Object System.Drawing.Font("Consolas", 9)
$TxtAdvanced.Size = New-Object System.Drawing.Size(570, 380)
$TxtAdvanced.Location = New-Object System.Drawing.Point(15, 15)
$TxtAdvanced.Text = "=== PARTIÇÕES ATIVAS ===`r`n$DiskPartitionsText`r`n`r`n=== ESTRUTURA DE PAGINAÇÃO DA MEMÓRIA ===`r`n$RamDetailsText"
$Tab3.Controls.Add($TxtAdvanced)

# Vincula as abas na interface principal
$TabControl.Controls.Add($Tab1)
$TabControl.Controls.Add($Tab2)
$TabControl.Controls.Add($Tab3)
$Form.Controls.Add($TabControl)

# Exibe a janela final renderizada de forma limpa e nativa
[void]$Form.ShowDialog()
